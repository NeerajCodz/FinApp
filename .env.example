# Production builds must use the same Convex deployment in EAS and Web hosting.
# Local development uses app-specific .env.local files with explicit endpoints.

EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_NOTIFICATION_PROJECT_ID=your-expo-project-id
CONVEX_DEPLOYMENT=prod:your-deployment
CONVEX_DEPLOY_KEY=prod:your-deploy-key
# Set as Convex deployment environment variables with `npx convex env set`.
AUTH_RESEND_KEY=re_your_resend_api_key
AUTH_EMAIL_FROM=Finapp <onboarding@resend.dev>

# Set the same deployment's public endpoint in the Web hosting environment.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
