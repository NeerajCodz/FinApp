{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@finapp/widgets": ["../widgets/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "../../convex/qrcode-core.d.ts"]
}
