{
  "name": "finapp",
  "version": "1.11.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/mobile",
    "apps/web",
    "packages/ui",
    "packages/widgets",
    "packages/mcp"
  ],
  "scripts": {
    "dev": "bun run compose:up",
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "widgets:preview": "bun run --cwd packages/widgets preview",
    "dev:mobile": "docker compose up mobileexpo",
    "dev:convex": "docker compose up convex convex-dashboard",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "compose:config": "docker compose config",
    "typecheck:mobile": "bun run --cwd apps/mobile typecheck",
    "typecheck:web": "bun run --cwd apps/web typecheck",
    "typecheck:widgets": "bun run --cwd packages/widgets typecheck",
    "typecheck": "bun run typecheck:mobile && bun run typecheck:web && bun run typecheck:widgets && bun run typecheck:mcp",
    "test": "bun run --cwd apps/mobile test && bun run test:web",
    "test:web": "bun run --cwd apps/web test",
    "lint": "bun run --cwd apps/mobile lint && bun run --cwd apps/web lint && bunx eslint packages/ui/src packages/widgets packages/mcp --max-warnings=0",
    "format:check": "bunx prettier --check .",
    "expo:doctor": "bun run --cwd apps/mobile expo:doctor",
    "validate": "bun run version:check && bun run typecheck && bun run test && bun run lint && bun run format:check && bun run expo:doctor",
    "generate:avatars": "bun scripts/generate-avatar-variants.ts",
    "cleanup:avatar-storage": "bun scripts/cleanup-avatar-storage.ts",
    "version:show": "node scripts/version.mjs show",
    "version:sync": "node scripts/version.mjs sync",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs bump",
    "version:build": "node scripts/version.mjs build",
    "version:tags": "node scripts/version.mjs tags",
    "version:release": "changeset version && node scripts/version.mjs adopt",
    "changeset": "changeset",
    "typecheck:mcp": "bun run --cwd packages/mcp typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^10.0.1",
    "babel-preset-expo": "~57.0.8",
    "eslint": "^10.9.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.2",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "overrides": {
    "expo-constants": "~57.0.25",
    "vite": "^7"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "convex": "^1.46.0",
    "fflate": "^0.8.3",
    "qrcode": "1.5.4"
  }
}
