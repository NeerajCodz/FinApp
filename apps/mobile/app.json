{
  "expo": {
    "name": "Finapp",
    "slug": "finapp",
    "version": "1.7.1",
    "scheme": "finapp",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Finapp uses the camera to scan receipts and bills.",
          "photosPermission": "Finapp reads photos you pick to scan receipts or share in chats.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Finapp uses the microphone to record voice messages in chats."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neerajcodz.finapp",
      "associatedDomains": ["applinks:fin.neeraj.fyi"],
      "buildNumber": "16"
    },
    "android": {
      "package": "com.neerajcodz.finapp",
      "allowBackup": false,
      "versionCode": 16,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "fin.neeraj.fyi",
              "pathPrefix": "/@"
            },
            {
              "scheme": "https",
              "host": "fin.neeraj.fyi",
              "pathPrefix": "/user/"
            },
            {
              "scheme": "https",
              "host": "fin.neeraj.fyi",
              "pathPrefix": "/people/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b1aa903-c0f5-480f-a7ff-7f3ce4ff27ee"
      }
    },
    "owner": "neerajcodz",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4b1aa903-c0f5-480f-a7ff-7f3ce4ff27ee"
    }
  }
}
