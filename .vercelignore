apps/mobile/android/
apps/mobile/ios/
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/web-build/
apps/mobile/.kotlin/
**/*.tsbuildinfo

node_modules/
apps/mobile/node_modules/
apps/mobile/.expo/
apps/mobile/dist/
.expo/
.env
.env.*
!.env.example
*.key
.tmp-*
artifacts/
apps/web/.next/
apps/web/out/
apps/web/node_modules/

# Local agent skills (skills-lock.json stays tracked)
.agents/
